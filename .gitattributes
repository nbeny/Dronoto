# Le dépôt est édité depuis Windows mais construit et exécuté sous Linux.
# Sans ces règles, git convertit les scripts en CRLF au checkout et bash
# échoue avec « bad interpreter: /usr/bin/env bash^M » — erreur classique
# et pénible à diagnostiquer.

* text=auto eol=lf

*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.msg       text eol=lf
*.srv       text eol=lf
*.action    text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.xml       text eol=lf
*.sdf       text eol=lf
*.urdf      text eol=lf
*.xacro     text eol=lf
*.launch.py text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
CMakeLists.txt text eol=lf

*.png  binary
*.jpg  binary
*.onnx binary
*.pcd  binary
*.bt   binary
